<odoo>
  <record id="payment_provider_form" model="ir.ui.view">
      <field name="name">mercado_pago_qr Provider Form</field>
      <field name="model">payment.provider</field>
      <field name="inherit_id" ref="payment.payment_provider_form"/>
      <field name="arch" type="xml">
          <xpath expr="//group[@name=&quot;provider_credentials&quot;]" position="inside">
              <group invisible="code != 'mercado_pago_qr'">
                  <field required="code == 'mercado_pago_qr' and state !='disabled'" name="mercado_pago_qr_access_token" password="True"/>
					<field name="mp_user_id" required="code == 'mercado_pago_qr' and state !='disabled'"/>
					<field name="store_id" required="code == 'mercado_pago_qr' and state !='disabled'"/>
					<field name="pos_id"/>
					<field name="mp_external_store_id" groups="base.group_no_one"/>
					<field name="mp_external_pos_id" groups="base.group_no_one"/>
					<field name="mp_qr_url" widget="CopyClipboardChar"/>
					<field name="mp_qr_image" invisible="1"/>
					<div>
						<button name="set_qr_info" invisible=" not mercado_pago_qr_access_token or not mp_user_id or not store_id or mp_qr_image" type="object" colspan="2" string="set qr_info"/>
						<button name="find_more_pos" type="object" colspan="2" string="Find more pos"/>
					</div>
              </group>
          </xpath>
      </field>
  </record>
</odoo>