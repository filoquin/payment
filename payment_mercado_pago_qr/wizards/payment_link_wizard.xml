<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_link_wizard_view_form" model="ir.ui.view">
        <field name="name">payment.link.wizard.form</field>
        <field name="model">payment.link.wizard</field>
        <field name="inherit_id" ref="payment.payment_link_wizard_view_form"></field>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="available_qr_provider_ids" invisible='1'/>
                <field name="qr_provider_id" domain="[('id', 'in', available_qr_provider_ids)]"/>
            </field>
            <field name="link" position="attributes">
                <attribute name="invisible">qr_provider_id</attribute>
            </field>
            <footer><button string="Create payment" invisible="not qr_provider_id" name="action_create_payment" type="object" data-hotkey="O"/></footer>
        </field>
    </record>

</odoo>